rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'leyfps@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function imagemNova() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /destaques/{arquivo} {
      allow read: if true;
      allow create, update: if isAdmin() && imagemNova();
      allow delete: if isAdmin();
    }

    match /portfolio/{arquivo} {
      allow read: if true;
      allow create, update: if isAdmin() && imagemNova();
      allow delete: if isAdmin();
    }
  }
}
